# Local development only. Replace the secret before sharing a deployment.
DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
# SQLite makes the Python-only setup work without a PostgreSQL installation.
# Compose overrides DB_ENGINE and POSTGRES_HOST for its PostgreSQL service.
DB_ENGINE=sqlite
POSTGRES_DB=carbondesk
POSTGRES_USER=carbondesk
POSTGRES_PASSWORD=carbondesk-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
FRONTEND_RELOAD=False
FRONTEND_STORAGE_SECRET=local-dev-only-change-me
# Optional: without a key the assistant gives rule-based answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
